{
  "name": "@ceebee/ui",
  "version": "1.0.2",
  "description": "Ceebee's design system: tokens, themed primitives, motion, and onboarding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benedictjeremiahh/ceebee-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/benedictjeremiahh/ceebee-ui#readme",
  "bugs": {
    "url": "https://github.com/benedictjeremiahh/ceebee-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./skins/*.css": "./dist/skins/*.css"
  },
  "scripts": {
    "build": "tsup && node ./stamp-client.mjs && node ./build-css.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "lucide-react": ">=0.400.0",
    "motion": "^13.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "antd": "6.6.1",
    "dayjs": "1.11.18"
  }
}
